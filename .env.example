# 复制为 .env 后按需填写（全部可选，不填也能正常游戏，只是没有 AI 旁白和语音）。
# 也可以不改这个文件，由房主在页面「设置 → 连接 AI 说书人」里填写自己的 Key。

# 文字模型（火山方舟 Ark，默认模型 doubao-seed-2-1-lite）
CLOCKTOWER_ARK_API_KEY=
CLOCKTOWER_ARK_MODEL=doubao-seed-2-1-lite-260915

# 豆包语音合成 2.0 专用 Key（X-Api-Key），与文字模型 Key 不通用
CLOCKTOWER_VOICE_KEY=

# 语音音色（默认：玲玲姐姐 2.0）
CLOCKTOWER_SPEAKER=zh_female_lingling_uranus_bigtts
